# Every setting restart-fly reads, left blank. On GitHub these live under
# Settings → Secrets and variables → Actions, not in a file. Locally:
#   cp .env.example .env    # fill it in; .env is git-ignored
#   set -a; . ./.env; set +a; ./restart.sh

# Secret. The restart-only token from create-token.sh. GitHub stores it as
# FLY_RESTART_TOKEN; restart.sh reads it as FLY_API_TOKEN.
FLY_API_TOKEN=

# Variable. The Fly app to restart.
FLY_APP=

# Variable, optional. A URL that must answer 2xx before a restart counts as done.
HEALTH_URL=

# Variable, optional. The process group to restart. Blank means "app".
PROCESS_GROUP=

# Secret, optional. A Discord channel webhook URL for the "restarted by" card.
# Only the GitHub workflow posts it; restart.sh doesn't.
DISCORD_WEBHOOK_URL=
